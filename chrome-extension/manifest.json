{
  "manifest_version": 3,
  "name": "Endurance Profiles for BRouter (bikerouter)",
  "version": "2026.8.23.2",
  "description": "Adds Endurance profiles to bikerouter.de and brouter.de",
  "icons": {
     "16": "icons/icon16.png",
     "32": "icons/icon32.png",
     "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://bikerouter.de/*",
        "https://brouter.de/brouter-web/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
